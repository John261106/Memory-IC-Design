VDDsrc VDD 0 DC 1.8
VGND GND 0 DC 0

* ---------------- Timeline (ns) ----------------
*   0-5    precharge
*   5-15   WRITE 1 -> cell(0,0)   (WL0, WE0, DATA=1)
*  15-20   precharge
*  20-30   WRITE 0 -> cell(1,1)   (WL1, WE1, DATA=0)
*  30-35   precharge
*  35-45   READ  cell(0,0)        (WL0, RE0)  expect 1
*  45-50   precharge
*  50-60   READ  cell(1,1)        (WL1, RE1)  expect 0
*  60-65   precharge
*  65-75   WRITE 0 -> cell(0,0)   (WL0, WE0, DATA=0)
*  75-80   precharge
*  80-90   WRITE 1 -> cell(1,1)   (WL1, WE1, DATA=1)
*  90-95   precharge
*  95-105  READ  cell(0,0)        expect 0
* 105-110  precharge
* 110-120  READ  cell(1,1)        expect 1
* 120-125  precharge

* Precharge (active LOW): low = precharging, high = precharge off
VPCB PCB 0 PWL(0n 0 5n 0 5.01n 1.8 15n 1.8 15.01n 0 20n 0 20.01n 1.8 30n 1.8 30.01n 0 35n 0 35.01n 1.8 45n 1.8 45.01n 0 50n 0 50.01n 1.8 60n 1.8 60.01n 0 65n 0 65.01n 1.8 75n 1.8 75.01n 0 80n 0 80.01n 1.8 90n 1.8 90.01n 0 95n 0 95.01n 1.8 105n 1.8 105.01n 0 110n 0 110.01n 1.8 120n 1.8 120.01n 0 125n 0)

* Write data: 1 until 20n, 0 from 20n to 80n, 1 from 80n onward
VDATA DATA 0 PWL(0n 1.8 20n 1.8 20.01n 0 80n 0 80.01n 1.8 125n 1.8)

* Word lines (high during read AND write)
* WL0: write(5-15), read(35-45), write(65-75), read(95-105)
VWL0 WL0 0 PWL(0n 0 5.01n 0 5.02n 1.8 15n 1.8 15.01n 0 35.01n 0 35.02n 1.8 45n 1.8 45.01n 0 65.01n 0 65.02n 1.8 75n 1.8 75.01n 0 95.01n 0 95.02n 1.8 105n 1.8 105.01n 0 125n 0)
* WL1: write(20-30), read(50-60), write(80-90), read(110-120)
VWL1 WL1 0 PWL(0n 0 20.01n 0 20.02n 1.8 30n 1.8 30.01n 0 50.01n 0 50.02n 1.8 60n 1.8 60.01n 0 80.01n 0 80.02n 1.8 90n 1.8 90.01n 0 110.01n 0 110.02n 1.8 120n 1.8 120.01n 0 125n 0)

* Write enables
VWE0 WE0 0 PWL(0n 0 5.02n 0 5.03n 1.8 15n 1.8 15.01n 0 65.02n 0 65.03n 1.8 75n 1.8 75.01n 0 125n 0)
VWE1 WE1 0 PWL(0n 0 20.02n 0 20.03n 1.8 30n 1.8 30.01n 0 80.02n 0 80.03n 1.8 90n 1.8 90.01n 0 125n 0)

* Read enables
VRE0 RE0 0 PWL(0n 0 35.02n 0 35.03n 1.8 45n 1.8 45.01n 0 95.02n 0 95.03n 1.8 105n 1.8 105.01n 0 125n 0)
VRE1 RE1 0 PWL(0n 0 50.02n 0 50.03n 1.8 60n 1.8 60.01n 0 110.02n 0 110.03n 1.8 120n 1.8 120.01n 0 125n 0)

* Unused word lines
VWL2 WL2 0 DC 0
VWL3 WL3 0 DC 0
VWL4 WL4 0 DC 0
VWL5 WL5 0 DC 0
VWL6 WL6 0 DC 0
VWL7 WL7 0 DC 0
VWL8 WL8 0 DC 0
